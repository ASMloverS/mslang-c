// int/float arithmetic, division polymorphism, mod, pow, conversions (T053/T054)
print(1 + 2)
print(5 - 8)
print(3 * 4)
print(1 + 2.5)
print(10 / 4)
print(10.0 / 4)
print(-10 % 3)
print(10 % -3)
print(2 ** 10)
print(2 ** 0.5)
print((-2) ** 2)
print(int("42"))
print(int(3.9))
print(float("3.14"))
print(float(2))
